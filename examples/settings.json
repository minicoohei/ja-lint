{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit|Bash|apply_patch",
        "hooks": [{ "type": "command", "command": "python3 ~/.claude/hooks/ja_lint/post_hook.py", "timeout": 10 }]
      }
    ],
    "Stop": [
      {
        "matcher": "",
        "hooks": [{ "type": "command", "command": "python3 ~/.claude/hooks/ja_lint/stop_hook.py", "timeout": 30 }]
      }
    ]
  }
}
